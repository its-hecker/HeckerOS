<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="66dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground" android:baselineAligned="false">
    <FrameLayout android:id="@+id/icon_frame" android:layout_width="34dp" android:layout_height="34dp">
        <!-- Native Settings supplies layered/adaptive icons. Tinting the entire
             drawable paints both foreground and background the same color. -->
        <androidx.preference.internal.PreferenceImageView android:id="@android:id/icon" android:layout_width="34dp" android:layout_height="34dp" android:padding="7dp" android:layout_gravity="center" android:scaleType="centerInside"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/text_frame" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingTop="10dp" android:paddingBottom="10dp" android:paddingStart="14dp" android:paddingEnd="8dp" android:orientation="vertical">
        <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/hecker_home_foreground" android:maxLines="2"/>
        <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="@color/hecker_secondary" android:maxLines="3"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/alert_frame" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:visibility="gone">
        <TextView android:id="@+id/alert_unnumbered" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="•" android:textColor="@color/hecker_accent" android:textSize="26sp" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/alert_numbered_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hecker_icon_background" android:visibility="gone">
            <TextView android:id="@+id/alert_number_fg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/hecker_accent" android:textSize="12sp" android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout android:id="@android:id/widget_frame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
</LinearLayout>
