<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="62dp" android:padding="10dp" android:gravity="center_vertical" android:background="@drawable/hecker_card_background">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/hecker_mascot" android:scaleType="centerCrop" android:background="@drawable/hecker_icon_background" android:clipToOutline="true" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hecker_maintained_by" android:textSize="11sp" android:textColor="@color/hecker_secondary"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hecker_maintainer_name" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/hecker_foreground"/>
        </LinearLayout>
        <Button android:background="@drawable/hecker_button_background" android:backgroundTint="@color/hecker_icon_background" android:textColor="@color/hecker_accent" android:id="@+id/hecker_suite_button" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="90dp" android:text="@string/hecker_suite_name" android:textSize="11sp" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
