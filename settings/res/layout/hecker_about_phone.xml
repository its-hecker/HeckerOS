<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/hecker_about_background"
    android:paddingHorizontal="18dp" android:paddingTop="18dp" android:paddingBottom="32dp">
    <com.android.settings.hecker.HeckerAboutGlowLayout
        android:id="@+id/hecker_about_glow" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="218dp"
        android:background="@drawable/hecker_about_hero">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="18dp"
            android:orientation="vertical">
            <TextView android:id="@+id/hecker_about_build_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:paddingHorizontal="14dp"
                android:paddingVertical="8dp" android:background="@drawable/hecker_about_status_pill"
                android:textColor="@color/hecker_about_text" android:textSize="12sp"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/hecker_about_brand" android:textSize="30sp"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                        android:textColor="@color/hecker_about_text" />
                    <TextView android:id="@+id/hecker_about_version_line"
                        style="@style/HeckerAboutReferenceCaption" android:layout_marginTop="5dp"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/hecker_about_caracal" android:layout_marginStart="12dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="76dp" android:layout_marginTop="18dp"
                android:paddingHorizontal="12dp" android:paddingVertical="10dp"
                android:background="@drawable/hecker_about_maintainer_surface"
                android:clipToOutline="true" android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:layout_width="52dp" android:layout_height="52dp"
                    android:src="@drawable/hecker_maintainer_avatar" android:scaleType="centerCrop"
                    android:background="@drawable/hecker_about_avatar_shape"
                    android:clipToOutline="true" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView style="@style/HeckerAboutReferenceCaption"
                        android:text="@string/hecker_about_maintained_by"
                        android:textColor="@color/hecker_about_maintainer_text"
                        android:alpha="0.82" />
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginTop="3dp">
                        <TextView android:id="@+id/hecker_about_maintainer_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:singleLine="true" android:ellipsize="end"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium"
                            android:textColor="@color/hecker_about_maintainer_text" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/hecker_about_verified"
                            android:contentDescription="@string/hecker_about_verified_label" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/hecker_about_support_action"
                    android:layout_width="wrap_content" android:layout_height="48dp"
                    android:minWidth="88dp" android:layout_marginStart="6dp"
                    android:gravity="center" android:paddingHorizontal="11dp"
                    android:text="@string/hecker_about_support"
                    android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hecker_about_maintainer_text"
                    android:background="@drawable/hecker_about_maintainer_surface"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:drawableStart="@drawable/hecker_about_heart"
                    android:drawableTint="@color/hecker_about_maintainer_text"
                    android:drawablePadding="5dp"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </com.android.settings.hecker.HeckerAboutGlowLayout>
    <LinearLayout android:id="@+id/hecker_about_name_action"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="72dp" android:layout_marginTop="16dp" android:paddingHorizontal="18dp"
        android:paddingVertical="12dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:clickable="true" android:focusable="true" android:clipToOutline="true"
        android:background="@drawable/hecker_about_surface"
        android:foreground="?android:attr/selectableItemBackground">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/HeckerAboutReferenceCaption" android:text="@string/hecker_about_device_name" />
            <TextView android:id="@+id/hecker_about_model" style="@style/HeckerAboutReferenceTitle"
                android:layout_marginTop="8dp" android:textSize="21sp" />
        </LinearLayout>
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginStart="12dp" android:src="@drawable/hecker_about_device"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp" android:baselineAligned="false">
        <LinearLayout android:id="@+id/hecker_about_android_action" style="@style/HeckerAboutReferenceTile"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView style="@style/HeckerAboutReferenceIcon" android:src="@drawable/hecker_about_android_icon" />
            <TextView style="@style/HeckerAboutReferenceCaption" android:layout_marginTop="8dp"
                android:text="@string/hecker_about_android_version" android:textSize="11sp" />
            <TextView android:id="@+id/hecker_about_android" style="@style/HeckerAboutReferenceTitle"
                android:layout_marginTop="6dp" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hecker_about_processor_action" style="@style/HeckerAboutReferenceTile"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp">
            <ImageView style="@style/HeckerAboutReferenceIcon" android:src="@drawable/hecker_about_processor_icon" />
            <TextView style="@style/HeckerAboutReferenceCaption" android:layout_marginTop="8dp"
                android:text="@string/hecker_about_processor" android:textSize="11sp" />
            <TextView android:id="@+id/hecker_about_processor" style="@style/HeckerAboutReferenceTitle"
                android:layout_marginTop="6dp" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp" android:baselineAligned="false">
        <LinearLayout style="@style/HeckerAboutReferenceTile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp">
            <TextView style="@style/HeckerAboutReferenceCaption" android:text="@string/hecker_about_memory_title" />
            <TextView android:id="@+id/hecker_about_memory" style="@style/HeckerAboutReferenceTitle" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout style="@style/HeckerAboutReferenceTile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp">
            <TextView style="@style/HeckerAboutReferenceCaption" android:text="@string/hecker_about_storage_title" />
            <TextView android:id="@+id/hecker_about_storage" style="@style/HeckerAboutReferenceTitle" android:textSize="14sp" android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="18dp" android:background="@drawable/hecker_about_surface">
        <TextView style="@style/HeckerAboutReferenceCaption" android:text="@string/hecker_about_patch_title" />
        <TextView android:id="@+id/hecker_about_patch" style="@style/HeckerAboutReferenceTitle" android:layout_marginTop="6dp" />
        <TextView style="@style/HeckerAboutReferenceCaption" android:text="@string/hecker_about_build_title" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/hecker_about_build" style="@style/HeckerAboutReferenceTitle" android:textSize="13sp" android:layout_marginTop="6dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/hecker_about_surface"
        android:clipToOutline="true" android:layout_marginTop="16dp">
        <LinearLayout android:id="@+id/hecker_about_software_action" style="@style/HeckerAboutReferenceRow">
            <ImageView style="@style/HeckerAboutReferenceIcon" android:src="@drawable/hecker_about_info" />
            <LinearLayout style="@style/HeckerAboutReferenceRowText">
                <TextView style="@style/HeckerAboutReferenceTitle" android:text="@string/hecker_about_software" />
                <TextView style="@style/HeckerAboutReferenceCaption" android:layout_marginTop="5dp"
                    android:text="@string/hecker_about_software_summary" />
            </LinearLayout>
            <ImageView style="@style/HeckerAboutReferenceIcon" android:src="@drawable/hecker_about_chevron" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginHorizontal="18dp" android:background="@color/hecker_about_divider" />
        <LinearLayout android:id="@+id/hecker_about_device_action" style="@style/HeckerAboutReferenceRow">
            <ImageView style="@style/HeckerAboutReferenceIcon" android:src="@drawable/hecker_about_device" />
            <LinearLayout style="@style/HeckerAboutReferenceRowText">
                <TextView style="@style/HeckerAboutReferenceTitle" android:text="@string/hecker_about_device" />
                <TextView style="@style/HeckerAboutReferenceCaption" android:layout_marginTop="5dp"
                    android:text="@string/hecker_about_device_summary" />
            </LinearLayout>
            <ImageView style="@style/HeckerAboutReferenceIcon" android:src="@drawable/hecker_about_chevron" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/hecker_about_community" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:includeFontPadding="false"
        android:gravity="center" android:clickable="true" android:focusable="true"
        android:textSize="14sp" android:textColor="@color/hecker_about_text"
        android:clipToOutline="true" android:background="@drawable/hecker_about_surface"
        android:foreground="?android:attr/selectableItemBackground" />
</LinearLayout>
