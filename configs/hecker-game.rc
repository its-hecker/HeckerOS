# SPDX-License-Identifier: Apache-2.0
on post-fs-data
    chown system system /sys/class/power_supply/charger/game_charge_disable
    chmod 0660 /sys/class/power_supply/charger/game_charge_disable
    write /sys/class/power_supply/charger/game_charge_disable 0

# Retry after driver probing; post-fs-data can run before this power supply appears.
on boot
    chown system system /sys/class/power_supply/charger/game_charge_disable
    chmod 0660 /sys/class/power_supply/charger/game_charge_disable
    write /sys/class/power_supply/charger/game_charge_disable 0

on property:sys.boot_completed=1
    chown system system /sys/class/power_supply/charger/game_charge_disable
    chmod 0660 /sys/class/power_supply/charger/game_charge_disable

# system_server requests only these fixed DAC permissions; no arbitrary path/value.
on property:sys.hecker.game_charge_access=1
    chown system system /sys/class/power_supply/charger/game_charge_disable
    chmod 0660 /sys/class/power_supply/charger/game_charge_disable
    setprop sys.hecker.game_charge_access 0
