// SPDX-License-Identifier: Apache-2.0
java_library {
    name: "HeckerVpnApi",
    srcs: ["aidl/**/*.aidl", "common/**/*.java"],
    sdk_version: "system_current",
    aidl: { local_include_dirs: ["aidl"] },
    installable: false,
}
android_app {
    name: "HeckerVpnController",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["HeckerVpnApi", "HeckerVpnSafeYaml"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    required: ["heckervpnd", "hecker-wg", "hecker-wg-quick", "hecker-tcp-core", "HeckerVpnDefaultPermissions"],
    optimize: { proguard_flags_files: ["proguard.flags"] },
}
cc_binary {
    name: "heckervpnd",
    srcs: ["native/daemon.cpp", "native/protocol.cpp", "native/proxy_config.cpp"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libcutils"],
    init_rc: ["heckervpnd.rc"],
    system_ext_specific: true,
    licenses: ["hecker_suite_license", "hecker_picojson_license"],
}
cc_binary {
    name: "hecker-tcp-core",
    srcs: ["native/proxy_core.cpp", "native/proxy_config.cpp"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    compile_multilib: "64",
    shared_libs: ["libdl"],
    required: ["libhecker_mihomo_core"],
    system_ext_specific: true,
    licenses: ["hecker_proxy_core_license", "hecker_picojson_license"],
}
prebuilt_etc {
    name: "HeckerVpnDefaultPermissions",
    src: "default-permissions-heckervpn.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
