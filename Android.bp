// SPDX-License-Identifier: Apache-2.0
// Deliberately use the global namespace, like other framework feature plugins.
package {
    default_applicable_licenses: ["hecker_suite_license"],
}

license {
    name: "hecker_suite_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

android_app {
    name: "HeckerSuite",
    manifest: "app/AndroidManifest.xml",
    srcs: ["app/src/**/*.java"],
    exclude_srcs: ["app/src/org/hecker/suite/SuiteActivity.java",
        "app/src/org/hecker/suite/LauncherController.java",
        "app/src/org/hecker/suite/AnimationSettingsActivity.java"],
    resource_dirs: ["app/res"],
    asset_dirs: ["app/assets"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    static_libs: ["lottie", "HeckerNetLabApi"],
    libs: ["framework-wifi"],
    required: ["HeckerSuitePrivappPermissions", "HeckerSuiteFreeformFeature", "HeckerGameInit"],
    optimize: {
        proguard_flags_files: ["app/proguard.flags"],
    },
}

// Keep hotspot permissions out of Settings and the presentation package.
java_library {
    name: "HeckerNetLabApi",
    srcs: ["netlab/aidl/**/*.aidl", "netlab/common/**/*.java"],
    sdk_version: "system_current",
    aidl: { local_include_dirs: ["netlab/aidl"] },
    installable: false,
}

android_app {
    name: "HeckerNetLabController",
    manifest: "netlab/AndroidManifest.xml",
    srcs: ["netlab/src/**/*.java"],
    resource_dirs: ["netlab/res"],
    static_libs: ["HeckerNetLabApi"],
    libs: ["framework-wifi", "framework-connectivity-t"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    required: ["HeckerNetLabPermissions", "HeckerNetLabDefaultPermissions"],
}

prebuilt_etc {
    name: "HeckerNetLabPermissions",
    src: "configs/privapp-permissions-hecker-netlab.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "HeckerNetLabDefaultPermissions",
    src: "configs/default-permissions-hecker-netlab.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

// UI is linked into the native Settings APK. Privileged feature services retain
// the separate HeckerSuite UID and are reached through a signature-only router.
android_library {
    name: "HeckerSuiteSettingsUi",
    manifest: "settings/suite/AndroidManifest.xml",
    srcs: [
        "app/src/org/hecker/suite/SuiteActivity.java",
        "app/src/org/hecker/suite/SuiteAbout.java",
        "app/src/org/hecker/suite/SuiteAnimation.java",
        "app/src/org/hecker/suite/SuiteGreetings.java",
        "app/src/org/hecker/suite/Ui.java",
    ],
    resource_dirs: ["app/res"],
    platform_apis: true,
    static_libs: ["lottie"],
}

prebuilt_etc {
    name: "HeckerSuitePrivappPermissions",
    src: "configs/privapp-permissions-hecker-suite.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "HeckerSuiteFreeformFeature",
    src: "configs/hecker-suite-freeform.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

aconfig_values {
    name: "hecker_suite_security_flags",
    package: "android.security",
    srcs: ["flags/security/*_flag_values.textproto"],
}

aconfig_value_set {
    name: "hecker_suite_aconfig_value_set",
    values: ["hecker_suite_security_flags", "hecker_suite_systemui_flags"],
}

prebuilt_media {
    name: "bootanimation_heckeros",
    src: "bootanimation/bootanimation.zip",
    filename: "bootanimation.zip",
    product_specific: true,
}

aconfig_values {
    name: "hecker_suite_systemui_flags",
    package: "com.android.systemui",
    srcs: ["flags/systemui/*_flag_values.textproto"],
}

// Grant the trusted game service access to the independent, leased kernel inhibitor.
prebuilt_etc {
    name: "HeckerGameInit",
    src: "configs/hecker-game.rc",
    filename_from_src: true,
    sub_dir: "init",
    system_ext_specific: true,
}
