<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center">
    <TextClock android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#F5F2E8" android:textSize="52sp"
        android:fontFamily="sans-serif" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/hs_clock" android:textColor="#BAC6CC" android:textSize="14sp" />
</LinearLayout>
