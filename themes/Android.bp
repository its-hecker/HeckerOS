// Pinned Lunaris theme resources, re-signed for HeckerOS Android 17.
package { default_applicable_licenses: ["hecker_lunaris_theme_assets"], }
license { name: "hecker_lunaris_theme_assets", license_kinds: ["legacy_proprietary"], }



android_app_import {
    name: "HeckerThemeAuroraWiFiOverlay",
    apk: "prebuilt/AuroraWiFiOverlay.apk",
    certificate: "platform",
    product_specific: true,
    enforce_uses_libs: false,
    dex_preopt: { enabled: false },
}


